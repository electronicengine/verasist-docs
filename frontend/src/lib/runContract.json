  "components": {
    "schemas": {
      "DeviceToolSchema": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": ""
          },
          "parameters": {
            "additionalProperties": true,
            "type": "object",
            "title": "Parameters"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "DeviceToolSchema",
        "description": "JSON-schema describing a tool implemented on the device (SDK) side.\n\nThese are not persisted as DB `Tool` rows \u2014 they are ephemeral,\nper-session declarations sent by the SDK client and merged into the\nLLM's function list for the lifetime of the live session only."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Message": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 16000,
            "minLength": 1,
            "title": "Text"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Revision"
          },
          "context": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "text",
          "expected_revision"
        ],
        "title": "Message"
      },
      "RunStartResponse": {
        "properties": {
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          },
          "workflow_run_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Workflow Run Id"
          },
          "workflow_run_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Workflow Run Name"
          },
          "state": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "State"
          },
          "status_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status Url"
          },
          "deadline": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deadline"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "session_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Token"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "scheduling": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scheduling"
          },
          "run_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Id"
          },
          "revision": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revision"
          },
          "closed": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Closed"
          },
          "turns": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Turns"
          }
        },
        "type": "object",
        "title": "RunStartResponse",
        "description": "Telephone/channel result, device token, or text run state according to run_type."
      },
      "TextTool": {
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^sdk_[a-zA-Z0-9_]{1,60}$",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "Description"
          },
          "parameters": {
            "additionalProperties": true,
            "type": "object",
            "title": "Parameters"
          }
        },
        "type": "object",
        "required": [
          "name",
          "description",
          "parameters"
        ],
        "title": "TextTool"
      },
      "TextToolTransport": {
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048,
            "title": "Url"
          },
          "token": {
            "type": "string",
            "maxLength": 256,
            "minLength": 40,
            "title": "Token"
          },
          "tools": {
            "items": {
              "$ref": "#/components/schemas/TextTool"
            },
            "type": "array",
            "maxItems": 32,
            "minItems": 1,
            "title": "Tools"
          }
        },
        "type": "object",
        "required": [
          "url",
          "token",
          "tools"
        ],
        "title": "TextToolTransport"
      },
      "TriggerCallRequest": {
        "properties": {
          "run_type": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "voice",
                  "video",
                  "text"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Type",
            "description": "Device voice, video, or conversational text. Omit to preserve configured telephone/channel execution."
          },
          "device_tools": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/DeviceToolSchema"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Tools"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "tool_transport": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TextToolTransport"
              },
              {
                "type": "null"
              }
            ]
          },
          "instructions": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 24000
              },
              {
                "type": "null"
              }
            ],
            "title": "Instructions"
          },
          "phone_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone Number"
          },
          "target": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target"
          },
          "channel": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TriggerChannel"
              },
              {
                "type": "null"
              }
            ]
          },
          "initial_context": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Initial Context"
          },
          "telephony_configuration_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Telephony Configuration Id"
          },
          "channel_configuration_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Channel Configuration Id"
          }
        },
        "type": "object",
        "title": "TriggerCallRequest",
        "description": "Start a run; explicit run_type selects device voice/video or conversational text."
      },
      "TriggerChannel": {
        "type": "string",
        "enum": [
          "phone",
          "whatsapp",
          "telegram",
          "instagram",
          "text"
        ],
        "title": "TriggerChannel",
        "description": "Channel an API Trigger node's public endpoint dispatches through."
      },
      "TurnCredentialsResponse": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "title": "Password"
          },
          "ttl": {
            "type": "integer",
            "title": "Ttl"
          },
          "uris": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Uris"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password",
          "ttl",
          "uris"
        ],
        "title": "TurnCredentialsResponse",
        "description": "Response model for TURN credentials."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
